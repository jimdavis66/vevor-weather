# Flask / SQLAlchemy (required for production)
DATABASE=postgresql+psycopg2://user:password@localhost:5432/vevor_weather
SECRET_KEY=change-me-to-a-long-random-string

# Logging (optional): DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Local dev server (python -m app)
PORT=5000

# Gunicorn (Docker image via app/gunicorn_entrypoint.py)
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30
